.rc-card { padding: 24rpx 26rpx; }
.rc-hover { transform: translate(2rpx, 2rpx); }
.rc-cover {
  width: 100%; height: 240rpx; border-radius: 18rpx; margin-bottom: 14rpx;
  background: var(--surface-2); display: block;
}
.rc-head { display: flex; align-items: center; justify-content: space-between; }
.rc-name { font-size: 32rpx; font-weight: 800; color: var(--text); }
.rc-tag {
  color: var(--on-accent, #fff); font-size: 20rpx; font-weight: 700;
  padding: 4rpx 16rpx; border-radius: 999rpx; border: 3rpx solid var(--border);
  background: var(--accent);
  flex-shrink: 0; margin-left: 12rpx;
}
.rc-meta { margin-top: 10rpx; font-size: 24rpx; color: var(--text-soft); }
.rc-cal { margin-left: 12rpx; }
.rc-summary {
  margin-top: 12rpx; font-size: 25rpx; color: var(--text-soft);
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden;
}
